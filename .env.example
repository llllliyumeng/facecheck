# 本地演示配置示例。请替换为运行时注入的值，不要提交真实密钥。
FACECHECK_DATA_ROOT=data
FACECHECK_DATABASE=data/facecheck.sqlite3
FACECHECK_STORAGE_ROOT=data/storage
FACECHECK_SM4_KEY=
FACECHECK_MAC_KEY=
FACECHECK_YUNET_MODEL=models/face_detection_yunet_2023mar.onnx
FACECHECK_RECOGNITION_MODEL=arcface
FACECHECK_ARCFACE_MODEL=models/arcface_w600k_r50.onnx
FACECHECK_SFACE_MODEL=models/face_recognition_sface_2021dec.onnx
FACECHECK_SEARCH_INTERVAL=1.0

# 云端配置由 scripts/init_cloud.py 创建的私有 cloud.env 提供。
# local 保留本机兼容行为；cloud 强制 HTTPS、角色认证、强密钥和 GmSSL native。
FACECHECK_DEPLOYMENT=local
FACECHECK_PUBLIC_ORIGIN=
FACECHECK_AUTH_CREDENTIALS_FILE=
# 二进制密钥文件；不得与对应 FACECHECK_*_KEY 同时配置。
FACECHECK_SM4_KEY_FILE=
FACECHECK_MAC_KEY_FILE=
# 本机可显式设 1，启用受保护特征缓存；cloud 未设置时默认启用。
# 不设置此变量即可使用上述按部署模式选择的默认值。
# FACECHECK_FEATURE_CACHE=1

# 逐视频 v2 信封与密钥轮换。provider factory 必须由受信部署配置提供，
# 生产实现应调用 KMS/HSM；不得将 SM2 私钥写入此文件或轮换任务记录。
# FACECHECK_VIDEO_KEY_PROVIDER_FACTORY=package.module:factory
# 公钥目录文件可公开读取；其 SHA-256 pin 必须经独立可信配置下发。
FACECHECK_VIDEO_KEY_DIRECTORY_FILE=
FACECHECK_VIDEO_KEY_DIRECTORY_SHA256=
# 只有确认所有服务实例已停止使用旧密钥写入后才设为 1。
FACECHECK_ROTATION_WRITERS_FENCED=0
# 只有确认旧对象的在途检索/缓存写入均已结束后才设为 1。
FACECHECK_ROTATION_READERS_DRAINED=0
# 备份根目录以系统路径分隔符连接；设为 1 表示运维已完整盘点所有备份/灾备位置。
FACECHECK_BACKUP_ROOTS=
FACECHECK_BACKUP_INVENTORY_COMPLETE=0
